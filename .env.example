# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# =========================
# SYSTEM ADMIN SECURITY
# =========================

# VITE_ADMIN_USERNAME: The username of the administrator account.
VITE_ADMIN_USERNAME="admin"

# VITE_ADMIN_PASSWORD_HASH: SHA-256 hash for password 'Asdfghjkl'
VITE_ADMIN_PASSWORD_HASH="d3a7fb2b836e947dd84605cc0fe6142a6163eede8a909e38c2b516f670319090"

# =========================
# CLOUD REST API BACKEND (RENDER)
# =========================

# VITE_API_URL: Your Express REST API backend URL on Render (e.g. https://fuel-expense-tracker-api.onrender.com)
VITE_API_URL=""

# =========================
# CLOUD BACKEND (OPTIONAL SUPABASE)
# =========================

# VITE_SUPABASE_URL: The public project URL from your Supabase settings panel.
VITE_SUPABASE_URL=""

# VITE_SUPABASE_ANON_KEY: The client-side anonymous API Key from your Supabase settings panel.
VITE_SUPABASE_ANON_KEY=""
